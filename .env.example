# ─── MRPrint World backend ───────────────────────────────────────────────────
# Copy to .env and fill in. The process refuses to start if anything required
# is missing or malformed, rather than failing later on the first request.

NODE_ENV=development
PORT=4000


# ─── Database ────────────────────────────────────────────────────────────────
# The database NAME must be in the URI. Omitting it lands you in the shared
# `test` database on a shared Atlas cluster — a collision this team has hit
# before. The name here is mrpw_catalogue:
#
#   mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mrpw_catalogue?retryWrites=true&w=majority
#
MONGODB_URI=


# ─── Auth ────────────────────────────────────────────────────────────────────
# Two DIFFERENT secrets, 32+ chars each, so a leaked access token can never be
# replayed as a refresh token. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d


# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated. No wildcard in production. Include the admin origin.
#   prod: https://www.mrprintworld.com,https://mrprintworld.com
CORS_ORIGINS=http://localhost:5173,http://localhost:5185


# ─── Cloudinary (optional until image uploads are needed) ────────────────────
# The API starts without these; the upload route returns a clear 503 instead.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=mrprintworld/products


# --- Payments (Razorpay) ----------------------------------------------------
# From the Razorpay dashboard: Settings -> API Keys. Use TEST keys until the
# whole flow is verified; they are prefixed rzp_test_.
#
# The API starts without these — checkout returns a clear 503 instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Settings -> Webhooks. Create a webhook pointing at
#   https://main.mrprintworld.com/api/webhooks/razorpay
# subscribed to payment.captured and payment.failed, and paste its secret here.
# Without it the webhook is REJECTED — an unverified webhook is just an
# anonymous POST claiming money arrived.
RAZORPAY_WEBHOOK_SECRET=
